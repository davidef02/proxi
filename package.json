{
  "name": "proxi",
  "productName": "Proxi",
  "version": "0.1.0",
  "description": "Personalized, high-retention multi-agent teaching engine",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/fetch-embedding-model.mjs",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "test:watch": "node --import tsx --test --watch tests/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lesson": "node --import tsx extensions/html-lesson.ts",
    "anki": "node --import tsx extensions/anki-sync.ts",
    "home": "node --import tsx extensions/homepage.ts",
    "data": "node --import tsx extensions/data-root.ts",
    "embed-bench": "node --import tsx extensions/embed-bench.ts",
    "app": "vite build --config app/web/vite.config.ts && node --import tsx app/server/main.ts",
    "app:serve": "node --import tsx app/server/main.ts",
    "app:web": "vite --config app/web/vite.config.ts",
    "app:build": "vite build --config app/web/vite.config.ts",
    "test:app": "node --import tsx --test app/test/*.test.ts",
    "golden:capture": "node --import tsx app/test/capture-golden.ts",
    "typecheck:app": "tsc -p app/tsconfig.json --noEmit",
    "e2e": "playwright test -c app/e2e/playwright.config.ts",
    "eval": "node --import tsx app/eval/run.ts",
    "desktop": "electron app/desktop/main.mjs",
    "desktop:install": "node app/desktop/install-shortcuts.mjs",
    "desktop:uninstall": "node app/desktop/install-shortcuts.mjs --uninstall",
    "desktop:smoke": "node app/desktop/smoke.mjs",
    "bench:baseline": "node app/desktop/bench-baseline.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/d3-force": "^3.0.10",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-shape": "^3.2.0",
    "@types/d3-zoom": "^3.0.9",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-vue": "^0.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@dagrejs/dagre": "^3.1.3",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.1",
    "@hono/node-server": "^2.1.5",
    "@huggingface/transformers": "4.3.2",
    "@lezer/highlight": "^1.2.5",
    "@streamdown/code": "^2.0.0",
    "@streamdown/math": "^1.0.3",
    "@streamdown/mermaid": "^1.0.3",
    "@xyflow/react": "^12.12.0",
    "d3-force": "^3.0.0",
    "d3-selection": "^3.0.0",
    "d3-shape": "^3.2.0",
    "d3-zoom": "^3.0.0",
    "dompurify": "^3.4.1",
    "hono": "^4.13.14",
    "katex": "^0.19.1",
    "lucide-react": "^1.62.0",
    "mermaid": "^12.2.0",
    "playwright-core": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "streamdown": "^2.7.1",
    "zod": "^4.6.7"
  }
}
